# Copy to deploy/.env (git-ignored) and fill in. docs/DEPLOYMENT.md §2.

# Required. The Postgres password; also used to build the backend's DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Public URLs as the browser sees them. The frontend tells the browser to
# call PUBLIC_API_URL; the API allows requests from PUBLIC_FRONTEND_URL (CORS).
PUBLIC_API_URL=http://localhost:8000
PUBLIC_FRONTEND_URL=http://localhost:3000

# Host ports.
API_PORT=8000
FRONTEND_PORT=3000

# Worker processes inside the worker container (pipelines run concurrently).
WORKER_CONCURRENCY=2

# Image tag for the built images.
DRUMSCORE_VERSION=latest
